      "type": "customNode",
      "data": {
        "id": "chatPromptTemplate_0",
        "label": "Chat Prompt Template",
        "version": 2,
        "name": "chatPromptTemplate",
        "type": "ChatPromptTemplate",
        "baseClasses": [
          "ChatPromptTemplate",
          "BaseChatPromptTemplate",
          "BasePromptTemplate",
          "Runnable"
        ],
        "category": "Prompts",
        "description": "Schema to represent a chat prompt",
        "inputParams": [
          {
            "label": "System Message",
            "name": "systemMessagePrompt",
            "type": "string",
            "rows": 4,
            "placeholder": "You are a helpful assistant that translates {input_language} to {output_language}.",
            "id": "chatPromptTemplate_0-input-systemMessagePrompt-string",
            "display": true
          },
          {
            "label": "Human Message",
            "name": "humanMessagePrompt",
            "description": "This prompt will be added at the end of the messages as human message",
            "type": "string",
            "rows": 4,
            "placeholder": "{text}",
            "id": "chatPromptTemplate_0-input-humanMessagePrompt-string",
            "display": true
          },
          {
            "label": "Format Prompt Values",
            "name": "promptValues",
            "type": "json",
            "optional": true,
            "acceptVariable": true,
            "list": true,
            "id": "chatPromptTemplate_0-input-promptValues-json",
            "display": true
          },
          {
            "label": "Messages History",
            "name": "messageHistory",
            "description": "Add messages after System Message. This is useful when you want to provide few shot examples",
            "type": "tabs",
            "tabIdentifier": "selectedMessagesTab",
            "additionalParams": true,
            "default": "messageHistoryCode",
            "tabs": [
              {
                "label": "Add Messages (Code)",
                "name": "messageHistoryCode",
                "type": "code",
                "hideCodeExecute": true,
                "codeExample": "const { AIMessage, HumanMessage, ToolMessage } = require('@langchain/core/messages');\n\nreturn [\n    new HumanMessage(\"What is 333382 🦜 1932?\"),\n    new AIMessage({\n        content: \"\",\n        tool_calls: [\n        {\n            id: \"12345\",\n            name: \"calculator\",\n            args: {\n                number1: 333382,\n                number2: 1932,\n                operation: \"divide\",\n            },\n        },\n        ],\n    }),\n    new ToolMessage({\n        tool_call_id: \"12345\",\n        content: \"The answer is 172.558.\",\n    }),\n    new AIMessage(\"The answer is 172.558.\"),\n]",
                "optional": true,
                "additionalParams": true
              }
            ],
            "id": "chatPromptTemplate_0-input-messageHistory-tabs",
            "display": true
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "systemMessagePrompt": "You are an expert Senior Technical Recruiter.\n\nCRITICAL INSTRUCTIONS:\n\n1. PRIORITIZE THE USER'S PROVIDED DATA.\n   If the user explicitly provides candidate scores, including `overall_score`,\n   use those scores directly and do NOT retrieve resumes.\n   Do not ask for resumes or additional candidate information in this case.\n\n2. RECOMMENDATION THRESHOLDS:\n   Determine the final recommendation strictly from `overall_score`:\n\n   - 85–100 → Strong Hire\n   - 70–84 → Hire\n   - 50–69 → Consider\n   - 0–49 → Reject\n\n   The recommendation MUST always match the corresponding score range.\n   Do not deviate from these thresholds.\n\n3. If the user provides an `overall_score` directly:\n   - Do not modify or recalculate the score.\n   - Do not infer additional candidate information.\n   - Assign the recommendation strictly according to the thresholds above.\n   - Do not use the `resume_retriever` tool.\n\n4. IF NO SCORE IS PROVIDED:\n   ALWAYS use the `resume_retriever` tool to search and pull all candidate resumes\n   from the vector store.\n   Do NOT ask the user to provide or paste resumes if they are already loaded.\n\n5. IF the user mentions a target role (e.g., \"Project Manager\") without giving a\n   job description, DO NOT ask for one. Automatically apply standard industry\n   requirements for that role to evaluate the candidates.\n\n6. IF no specific job title is provided, analyze and compare all candidate resumes\n   based on their experience, overall technical/management skills, and seniority.\n\n\nEVALUATION PROCESS:\n\nWhen resumes are available:\n\n- Fetch context for all candidates using `resume_retriever`.\n- Evaluate and compare every candidate found:\n  - Skills Match (0-100)\n  - Experience Match (0-100)\n  - Education Match (0-100)\n  - Overall Score (0-100)\n  - Recommendation: Strong Hire / Hire / Consider / Reject\n- For every score, provide a clear, evidence-based `justification`\n  using facts from the resume.\n- Generate 3–5 interview questions for each candidate.\n\nWhen the user provides only `overall_score` values:\n\n- Use the provided scores exactly as given.\n- Assign recommendations according to the predefined thresholds.\n- Do not retrieve or request resumes.\n- Do not generate resume-based justifications.\n- Return the score and recommendation for each candidate.\n\nBefore returning the final result, verify that every recommendation\nmatches the defined `overall_score` threshold.\n\nReturn the final report in structured JSON format.",
          "humanMessagePrompt": "{input}",
          "promptValues": "",
          "messageHistory": "messageHistoryCode"
        },
        "outputAnchors": [
          {
            "id": "chatPromptTemplate_0-output-chatPromptTemplate-ChatPromptTemplate|BaseChatPromptTemplate|BasePromptTemplate|Runnable",
